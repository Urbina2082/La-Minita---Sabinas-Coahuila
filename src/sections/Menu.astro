---
import { MenuData } from "../data/menu.js";

function formatPrecio(precio) {
    if (typeof precio === "number") {
        return `$${precio}`;
    }

    if (precio && typeof precio === "object") {
        return Object.entries(precio)
            .map(([tipo, valor]) => `${tipo.toUpperCase()}: $${valor}`)
            .join(" / ");
    }

    return "";
}
---

<section class="menu" id="menu">

    <div class="encabezado">
        <span>04</span>
        <i></i>
        <small>EL MENÚ</small>
    </div>

    <h1>EL MENÚ</h1>

    <p class="intro">
        De la parrilla al mar. Del primer trago al último.
    </p>


    <!-- CATEGORÍAS -->

    <div class="categorias">

        {MenuData.map((categoria, index) => (

            <button
                type="button"
                class={index === 0 ? "activo" : ""}
                data-categoria={categoria.id}
            >
                {categoria.nombre}
            </button>

        ))}

    </div>


    <!-- MENÚ -->

    <div class="menu-contenido">

        {MenuData.map((categoria, index) => (

            <div
                id={categoria.id}
                class={`categoria ${index !== 0 ? "oculto" : ""}`}
            >

                <p class="subtitulo">
                    {categoria.subtitulo}
                </p>

                <div class="titulo-categoria">
                    <h2>{categoria.nombre}</h2>
                    <span></span>
                </div>


                <div class="platillos">

                    {categoria.items.map((item) => (

                        <article
                            class={`platillo ${
                                item.descripcion || item.especialidad
                                    ? "especial"
                                    : ""
                            }`}
                        >

                            <div class="nombre-precio">

                                <h3>
                                    {item.nombre}
                                </h3>

                                <strong>
                                    {formatPrecio(item.precio)}
                                </strong>

                            </div>


                            {item.descripcion && (

                                <p class="descripcion">
                                    {item.descripcion}
                                </p>

                            )}


                            {item.especialidad && (

                                <small class="especialidad">
                                    ESPECIALIDAD
                                </small>

                            )}

                        </article>

                    ))}

                </div>

            </div>

        ))}

    </div>

</section>

<script>

    const botones = document.querySelectorAll("[data-categoria]");
    const categorias = document.querySelectorAll(".categoria");

    botones.forEach((boton) => {

        boton.addEventListener("click", () => {

            const id = boton.dataset.categoria;

            // Ocultar todas
            categorias.forEach((categoria) => {
                categoria.classList.add("oculto");
            });

            // Mostrar seleccionada
            document
                .getElementById(id)
                ?.classList.remove("oculto");


            // Cambiar botón activo
            botones.forEach((btn) => {
                btn.classList.remove("activo");
            });

            boton.classList.add("activo");

        });

    });

</script>


<style>


/* =========================
   MENU PRINCIPAL
========================= */

.menu {
    width: 100%;
    max-width: 1200px;
ƒ
    margin: 0 auto;
    padding: 100px 40px;

    color: #eee;

    box-sizing: border-box;
}


/* =========================
   ENCABEZADO
